
// Crimson Pro is the app's own UI font (not Bible content) — self-hosted from the curated
// fonts bucket rather than Google Fonts. $assets_prefix is substituted by postcss.config.mjs and
// points at the local bookcover dev server in dev, the prod assets bucket otherwise
@font-face
    font-family: 'Crimson Pro'
    font-style: normal
    font-weight: 400
    src: url('$assets_prefix/fonts/Crimson%20Pro/CrimsonPro-Regular.ttf')

@font-face
    font-family: 'Crimson Pro'
    font-style: normal
    font-weight: 700
    src: url('$assets_prefix/fonts/Crimson%20Pro/CrimsonPro-Bold.ttf')

@font-face
    font-family: 'Crimson Pro'
    font-style: italic
    font-weight: 400
    src: url('$assets_prefix/fonts/Crimson%20Pro/CrimsonPro-Italic.ttf')

@font-face
    font-family: 'Crimson Pro'
    font-style: italic
    font-weight: 700
    src: url('$assets_prefix/fonts/Crimson%20Pro/CrimsonPro-BoldItalic.ttf')


// Vuetify 4 removed its global CSS reset (moved to per-component styles) — restore zeroed
// margins on plain elements since the app relies on that for its many bare h1-h6/p tags
@layer vuetify-core.reset
    ul, ol, figure, details, summary
        padding: 0
        margin: 0
    h1, h2, h3, h4, h5, h6, p
        margin: 0


html
    font-size: 12pt
    line-height: 1
    height: 100%
    overflow: hidden !important
    background-color: #333
    // Enable momentum scroll for iOS
    -webkit-overflow-scrolling: touch

body
    height: 100%
    overflow: hidden


// Our custom-component icon aliases (init.ts) render their raw imported <svg> as-is, which
// lacks Vuetify's own ".v-icon__svg" class (only applied to its built-in path-based icons) —
// without this the icon keeps its own intrinsic width/height and default black fill instead of
// following the surrounding ".v-icon" box's size and current text color
.v-icon svg
    width: 100%
    height: 100%
    fill: currentColor

.v-checkbox
    --v-input-control-height: 24px !important

// md3's radio-group indents both its own label and its row of radios under it (a hierarchy
// cue that doesn't match this app's flush-left fields/hints elsewhere) — flush both back out
.v-radio-group > .v-input__control > .v-label
    margin-inline-start: 0

.v-radio-group > .v-input__control > .v-label + .v-selection-control-group
    padding-inline-start: 0

// Vuetify's default label opacity (the shared --v-medium-emphasis-opacity var, 0.6) reads as
// only ~5.3:1 against this app's tinted (non-white) --app-bg — passes AA but not by much.
// Override just the label's own opacity (not the shared var, which other things also rely on)
.v-label
    opacity: 0.75

.v-btn
    text-transform: none !important

// Helper text below a form field. Vuetify's own `hint`/`messages` props are preferred wherever
// the component supports them; this class covers every field that can't use them (checkboxes,
// sliders, radio groups, custom fields). Add `text-error` for a warning-toned hint
.hint
    font-size: 0.9rem
    line-height: 1.4
    margin-top: 6px
    margin-bottom: 12px
    color: rgba(var(--v-theme-on-surface), var(--v-medium-emphasis-opacity))


// Vuetify's <v-card-actions> forces `slim` onto every button it wraps (padding: 0 8px via
// provideDefaults), which leaves dialog action rows looking cramped. Restore normal button
// padding for dialogs app-wide — a defaults entry can't win against that provideDefaults call.
.v-dialog .v-card-actions .v-btn--slim
    padding-left: 12px
    padding-right: 12px


// New-design wizard (non-mobile only — mobile is fullscreen): anchor the card near the top of
// the viewport instead of vertically centering it, so moving between steps of differing height
// only shifts the card's bottom edge rather than re-centering the whole dialog. Overrides
// Vuetify's centered `.v-dialog > .v-overlay__content` (align-items: center, margin: 24px).
// Also caps the card's own dimensions so tall/wide steps stay a comfortable reading size.
.wizard-dialog
    align-self: flex-start
    margin-top: 6vh
    max-width: 800px
    min-height: 600px
    max-height: min(1400px, calc(100% - 6vh - 48px))


#app
    display: flex
    height: 100%
    overflow: hidden


// Plain text links use the accent color; component anchors (buttons, list items) keep their
// own styling and must be excluded
a:not(.v-btn):not(.v-list-item)
    color: rgb(var(--v-theme-secondary))


iframe
    border-style: none


@media print
    body::before
        content: "You are printing the app. Click the print button within the generated PDF instead."
        z-index: 99999
        position: absolute
        top: 0
        bottom: 0
        right: 0
        left: 0
        padding: 48px
        background-color: white
        color: black
        font-size: 40px
        font-weight: bold
        text-align: center
