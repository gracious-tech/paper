
.fail-splash
    // Display full screen
    position: fixed
    top: 0
    bottom: 0
    left: 0
    right: 0
    // Cover all
    z-index: 99999
    // Scroll if needed
    overflow: auto
    // Style
    padding: 20px
    padding-top: 80px
    user-select: none
    background-color: rgba(100%, 75%, 50%)
    text-align: center

    @media print
        display: none

    *
        color: #000 !important
        line-height: 1

    h1
        font-size: 25px

    p
        margin: 40px 0

    a
        color: #009 !important
        text-decoration: underline !important

    button
        font-size: 16px
        padding: 6px 10px
        background-color: #fffb !important
        border-style: none
        border-radius: 6px
        cursor: pointer
        box-shadow: 0px 2px 5px 1px rgba(0, 0, 0, 0.2)

