doctype html
html

    head
        meta(charset='utf-8')
        meta(name='viewport' content='width=device-width, initial-scale=1')
        title Paper Bible
        meta(name='description' content="Print your own Bible, customise how it looks, and optionally include multiple translations and study notes.")
        meta(property='og:image' content='https://paper.bible/social.jpg')
        link(rel='icon' href='/icon.png')

        //- Warm the connections boot blocks on, so their DNS + TLS handshakes overlap
            downloading and parsing the bundle rather than starting after it. All four are hit
            within the first moments: the Bible collection manifest and Firebase auth/Firestore
            are awaited before the app mounts at all (see init.ts), and the Typst WASM compiler
            plus the font manifest are requested immediately after. `crossorigin` is required —
            these are all CORS fetches, and a preconnect without it warms the wrong connection
            pool and is simply wasted. Production only: in dev these origins are served locally
            (see content.ts and ASSETS_PREFIX in typst.ts)
        if PROD
            link(rel='preconnect' href='https://v1.fetch.bible' crossorigin)
            link(rel='preconnect' href='https://assets.paper.bible' crossorigin)
            link(rel='preconnect' href='https://firestore.googleapis.com' crossorigin)
            link(rel='preconnect' href='https://identitytoolkit.googleapis.com' crossorigin)

            //- The Bible collection manifest (~100KB compressed, ~750KB of JSON) is awaited
                before the app mounts, and nothing in the designs layer can run without it —
                clean_blueprint, get_default_blueprint and content_summary all read
                `content.collection`/`content.translations`. Requesting it here starts it while
                the bundle is still downloading and parsing instead of after, so the two
                overlap rather than running in series. Must match the request fetch-client
                actually makes (`endpoint + 'manifest.json'`, mode 'cors', no credentials) or
                the browser fetches it twice rather than reusing this one
            link(rel='preload' as='fetch' type='application/json'
                href='https://v1.fetch.bible/manifest.json' crossorigin)
        style
            :sss
                // LOADING SCREEN ONLY

                body
                    margin: 0

                @keyframes loading
                    from
                        transform: rotate(0deg)
                    to
                        transform: rotate(360deg)

                #app > svg.loading
                    // Not reusable in other parts of app
                    position: absolute
                    top: 46%
                    left: 46%

                svg.loading
                    height: 50px
                    width: 50px
                    animation-name: loading
                    animation-duration: 2.5s  // NOTE need to adjust steps if this changes
                    // NOTE 60's quality close to linear, and ~1/2 CPU usage
                    animation-timing-function: steps(60)
                    animation-iteration-count: infinite

                svg.loading circle
                    fill: transparent
                    stroke: #888888


        //- Define scripts
        //- NOTE Vite processes URLs relative to where index.html is (not index.pug)
        script(src='/src/init.ts' type='module')


    body
        div#app
            //- Simplified low-CPU-cost Material progress circle (proportions same)
            svg.loading(viewBox='0 0 100 100' preserveAspectRatio='xMidYMid meet')
                //- Place in middle with radius 40 (stroke length of 250 surrounds whole circle)
                circle(cx='50' cy='50' r='40' stroke-width='10' stroke-dasharray='190')

        //- When the bundle never starts (no ES module support, or syntax it can't parse),
            services/errors.ts never runs either and the spinner above would spin forever —
            this classic script catches both cases (see the file for why it isn't inline).
            Kept in body so document.body exists for the no-modules case, and it still runs
            before the (deferred) module bundle executes
        script(src='/boot_check.js')
