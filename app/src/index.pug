doctype html
html

    head
        meta(charset='utf-8')
        meta(name='viewport' content='width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no')
        title Paper Bible
        meta(name='description' content="Print your own Bible, customise how it looks, and optionally include multiple translations and study notes.")
        meta(property='og:image' content='https://paper.bible/social.jpg')
        link(rel='icon' href='/icon.png')
        //- Makes the app installable (see services/install.ts). iOS reads its home-screen icon
            from apple-touch-icon rather than the manifest, and needs it square since it rounds
            the corners itself. theme-color tints the browser's (or installed app's) title bar
        link(rel='manifest' href='/manifest.json')
        link(rel='apple-touch-icon' href='/icons/apple_touch_180.png')
        meta(name='theme-color' content='#642b4c')

        //- Warm the connections boot blocks on, so their DNS + TLS handshakes overlap
            downloading and parsing the bundle rather than starting after it. All four are hit
            within the first moments: the Bible collection manifest and Firebase auth/Firestore
            are awaited before the app mounts at all (see init.ts), and the Typst WASM compiler
            plus the font manifest are requested immediately after. `crossorigin` is required —
            these are all CORS fetches, and a preconnect without it warms the wrong connection
            pool and is simply wasted. Production only: in dev these origins are served locally
            (see content.ts and ASSETS_PREFIX in typst.ts)
        if PROD
            link(rel='preconnect' href='https://v1.fetch.bible' crossorigin)
            link(rel='preconnect' href='https://assets.paper.bible' crossorigin)
            link(rel='preconnect' href='https://firestore.googleapis.com' crossorigin)
            link(rel='preconnect' href='https://identitytoolkit.googleapis.com' crossorigin)

            //- The Bible collection manifest (~100KB compressed, ~750KB of JSON) is awaited
                before the app mounts, and nothing in the designs layer can run without it —
                clean_blueprint, get_default_blueprint and content_summary all read
                `content.collection`/`content.translations`. Requesting it here starts it while
                the bundle is still downloading and parsing instead of after, so the two
                overlap rather than running in series. Must match the request fetch-client
                actually makes (`endpoint + 'manifest.json'`, mode 'cors', no credentials) or
                the browser fetches it twice rather than reusing this one
            link(rel='preload' as='fetch' type='application/json'
                href='https://v1.fetch.bible/manifest.json' crossorigin)
        style
            :sss
                // LOADING SCREEN ONLY

                body
                    margin: 0

                // The loading screen sits above #app (not in it) so the app can mount beneath
                // it and it can then fade out (see init.ts), rather than vanishing the moment
                // Vue replaces #app's contents. It's the compile timer's gradient and book (see
                // DisplayDesignVersion.vue, AnimatedBook.vue), so loading and building look alike
                #boot_loader
                    position: fixed
                    top: 0
                    bottom: 0
                    left: 0
                    right: 0
                    z-index: 9999
                    overflow: hidden
                    display: flex
                    justify-content: center
                    align-items: center
                    background-color: #e73c7e
                    transition: opacity 0.3s ease
                    pointer-events: none

                    &.done
                        opacity: 0

                // The gradient, panned by transform rather than background-position: the bundle
                // is parsing on the main thread meanwhile, and a transform animates on the
                // compositor, so it neither competes with that nor stutters during it
                #boot_loader::before
                    content: ''
                    position: absolute
                    top: 0
                    left: 0
                    width: 400%
                    height: 400%
                    background-image: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab)
                    will-change: transform
                    animation: boot_pan 8s ease infinite

                // Translate percentages are of the 400% layer itself, so 75% pans it a full
                // three viewports, as far as background-position 100% does on the compile timer
                @keyframes boot_pan
                    0%
                        transform: translate(0, 0)
                    25%
                        transform: translate(-75%, -37.5%)
                    50%
                        transform: translate(0, -75%)
                    75%
                        transform: translate(-75%, -75%)
                    100%
                        transform: translate(0, 0)

                // The book, with lines of text on both pages
                .boot_book
                    width: 200px
                    height: 140px
                    box-sizing: border-box
                    position: relative
                    border-radius: 8px
                    perspective: 1000px

                .boot_book::before
                    content: ''
                    position: absolute
                    left: 10px
                    right: 10px
                    top: 10px
                    bottom: 10px
                    border-radius: 8px
                    box-shadow: 0 0 10px rgba(0, 0, 0, 0.3)
                    background-color: #f0f0f0
                    background-size: 60px 5px
                    // Vuetify's reset sets this on everything, but it hasn't loaded yet
                    background-repeat: no-repeat
                    background-image: linear-gradient(#ccc 100px, transparent 0), linear-gradient(#ccc 100px, transparent 0), linear-gradient(#ccc 100px, transparent 0), linear-gradient(#ccc 100px, transparent 0), linear-gradient(#ccc 100px, transparent 0), linear-gradient(#ccc 100px, transparent 0), linear-gradient(#ccc 100px, transparent 0), linear-gradient(#ccc 100px, transparent 0), linear-gradient(#ccc 100px, transparent 0), linear-gradient(#ccc 100px, transparent 0)
                    background-position: 15px 20px, 15px 40px, 15px 60px, 15px 80px, 15px 100px, 105px 20px, 105px 40px, 105px 60px, 105px 80px, 105px 100px

                // The turning page (a plain colour, unlike AnimatedBook's, which also fades its
                // colour and so repaints every frame; a rotation alone is compositor-only)
                .boot_book::after
                    content: ''
                    position: absolute
                    width: calc(50% - 10px)
                    right: 10px
                    top: 10px
                    bottom: 10px
                    border-radius: 8px
                    background-color: #f8f8f8
                    background-size: 60px 5px
                    // Vuetify's reset sets this on everything, but it hasn't loaded yet
                    background-repeat: no-repeat
                    background-image: linear-gradient(#ccc 100px, transparent 0), linear-gradient(#ccc 100px, transparent 0), linear-gradient(#ccc 100px, transparent 0), linear-gradient(#ccc 100px, transparent 0), linear-gradient(#ccc 100px, transparent 0)
                    background-position: 50% 20px, 50% 40px, 50% 60px, 50% 80px, 50% 100px
                    transform-origin: left center
                    animation: boot_paging 2s ease-out infinite

                @keyframes boot_paging
                    from
                        transform: rotateY(0deg)
                    to
                        transform: rotateY(-180deg)

                // Hold still for anyone who's asked for less motion
                @media (prefers-reduced-motion: reduce)
                    #boot_loader::before, .boot_book::after
                        animation: none


        //- Define scripts
        //- NOTE Vite processes URLs relative to where index.html is (not index.pug)
        script(src='/src/init.ts' type='module')


    body
        div#app
        div#boot_loader
            div.boot_book

        //- When the bundle never starts (no ES module support, or syntax it can't parse),
            services/errors.ts never runs either and the loading screen above would stay forever —
            this classic script catches both cases (see the file for why it isn't inline).
            Kept in body so document.body exists for the no-modules case, and it still runs
            before the (deferred) module bundle executes
        script(src='/boot_check.js')
