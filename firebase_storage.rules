rules_version = '2';


// NOTE All paths are publicly gettable (not listable) — ids are unguessable url64, and letting
//      PDFs/fonts be shared by link without an auth check keeps sharing simple; denying list
//      keeps the exact path as the whole capability (no enumerating user_fonts/{uid}/ etc)
// NOTE Cross-service firestore.get() requires a one-time IAM grant for the Rules service
//      account (prompted on first deploy)

service firebase.storage {
    match /b/{bucket}/o {

        // Version PDFs — create-once by owner (in-browser compile path), no overwrite/delete
        // by clients (re-creation is allowed again after lifecycle deletion since the object
        // no longer exists)
        match /versions/{version_id}/doc.pdf {

            function version() {
                return firestore.get(
                    /databases/(default)/documents/versions/$(version_id));
            }

            allow get: if true;

            allow create: if request.auth != null
                && resource == null
                && version().data.owner == request.auth.uid
                && request.resource.contentType == 'application/pdf'
                && request.resource.size < 200 * 1024 * 1024;
        }

        // Version cover PDFs — same create-once/owner semantics as doc.pdf (only present for
        // versions whose frozen blueprint has a cover)
        match /versions/{version_id}/cover.pdf {
            allow get: if true;

            allow create: if request.auth != null
                && resource == null
                && firestore.get(
                    /databases/(default)/documents/versions/$(version_id))
                    .data.owner == request.auth.uid
                && request.resource.contentType == 'application/pdf'
                && request.resource.size < 50 * 1024 * 1024;
        }

        // Per-version snapshots of custom font bytes (immutable alongside the version, and
        // nested under versions/ so the lifecycle rule sweeps them together with the PDF)
        match /versions/{version_id}/fonts/{file} {
            allow get: if true;

            allow create: if request.auth != null
                && firestore.get(
                    /databases/(default)/documents/versions/$(version_id))
                    .data.owner == request.auth.uid
                && request.resource.size < 20 * 1024 * 1024;
        }

        // Per-version snapshot of the cover's background image (swept with the version by the
        // lifecycle rule, like the font snapshots above)
        match /versions/{version_id}/cover/{file} {
            allow get: if true;

            allow create: if request.auth != null
                && firestore.get(
                    /databases/(default)/documents/versions/$(version_id))
                    .data.owner == request.auth.uid
                && request.resource.size < 20 * 1024 * 1024;
        }

        // Per-version snapshots of uploaded passage images (swept with the version by the
        // lifecycle rule, like the font/cover snapshots above)
        match /versions/{version_id}/images/{file} {
            allow get: if true;

            allow create: if request.auth != null
                && firestore.get(
                    /databases/(default)/documents/versions/$(version_id))
                    .data.owner == request.auth.uid
                && request.resource.size < 20 * 1024 * 1024;
        }

        // Per-user reusable custom font library
        match /user_fonts/{uid}/{path=**} {
            allow get: if true;

            allow delete: if request.auth != null && request.auth.uid == uid;

            allow create, update: if request.auth != null && request.auth.uid == uid
                && request.resource.size < 20 * 1024 * 1024;
        }

        // Per-user cover background image library (content-addressed by hash, so re-saving an
        // unchanged image is an idempotent overwrite of identical bytes)
        match /user_cover_images/{uid}/{path=**} {
            allow get: if true;

            allow delete: if request.auth != null && request.auth.uid == uid;

            allow create, update: if request.auth != null && request.auth.uid == uid
                && request.resource.size < 20 * 1024 * 1024;
        }

        // Per-user reusable passage image library (content-addressed by hash, same as the cover
        // bg image library above)
        match /user_content_images/{uid}/{path=**} {
            allow get: if true;

            allow delete: if request.auth != null && request.auth.uid == uid;

            allow create, update: if request.auth != null && request.auth.uid == uid
                && request.resource.size < 20 * 1024 * 1024;
        }
    }
}
