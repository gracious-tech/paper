rules_version = '2';


// NOTE All paths are publicly gettable (never listable) — every id in a path is unguessable
//      url64, so letting PDFs and assets be fetched by link without an auth check keeps
//      sharing simple, while denying list keeps the exact path as the whole capability
// NOTE Nothing here grants delete. Removing anything is the server's job (see assets.ts),
//      which is what stops one editor destroying the inputs a published version renders from
// NOTE Cross-service firestore.get() requires a one-time IAM grant for the Rules service
//      account (prompted on first deploy)

service firebase.storage {
    match /b/{bucket}/o {

        // --- Per-design assets ------------------------------------------------------------
        //
        // Uploaded images and fonts belong to a design, not to an account: the design is the
        // only scope in which "is anything still referencing this?" is answerable, which is
        // what makes deletion possible at all. Three prefixes, all keyed by design id and all
        // content-addressed (so a basename is a pure function of the bytes):
        //   design_assets/  what the live design references — swept by the server when the
        //                   design stops naming it
        //   version_assets/ frozen snapshots, shared by every version of the design. Append-
        //                   only, so editing a design can never break an already-rendered one
        //   design_cache/   regenerable painted/torn variants, swept by a lifecycle rule
        // Writes authorise against the *design* doc's editor_uids; deletes are Admin-SDK only
        // (the client has no path to remove a published version's inputs), and nothing is
        // listable, so the exact path stays the whole capability.

        function design_editors(design_id) {
            return firestore.get(
                /databases/(default)/documents/designs/$(design_id)).data.editor_uids;
        }

        // Pin the content type as well as the size. Without it any file under 20MB could be
        // parked on these prefixes and handed back out publicly from a Google domain, and the
        // compile service's image pipeline would be fed arbitrary bytes. The images are the
        // three the app ever uploads (IMAGE_MIME_EXT / BG_MIME_EXT, client-side); the fonts are
        // labelled at upload by sniffing the magic number (font_mime in custom_fonts.ts),
        // because the stored basename is deliberately type-neutral.
        // WARN Adding an upload format means adding it here too, or the upload is denied
        function allowed_asset_type() {
            return request.resource.contentType in
                ['image/jpeg', 'image/png', 'image/webp', 'font/ttf', 'font/otf'];
        }

        match /design_assets/{design_id}/{file} {
            allow get: if true;

            allow create, update: if request.auth != null
                && request.auth.uid in design_editors(design_id)
                && allowed_asset_type()
                && request.resource.size < 20 * 1024 * 1024;
        }

        // Append-only as a rule, not a convention — `resource == null` is what guarantees a
        // design edit can't rewrite the bytes a published version renders from. Clients must
        // therefore check existence first and treat a denied create as "a co-editor froze it
        // already" (same bytes, same basename) rather than a failure
        match /version_assets/{design_id}/{file} {
            allow get: if true;

            allow create: if request.auth != null
                && resource == null
                && request.auth.uid in design_editors(design_id)
                && allowed_asset_type()
                && request.resource.size < 20 * 1024 * 1024;
        }

        // Only ever holds the painted/torn PNG variants the client bakes, so the type is pinned
        // tighter than the other two prefixes rather than sharing their allowlist
        match /design_cache/{design_id}/{file} {
            allow get: if true;

            allow create, update: if request.auth != null
                && request.auth.uid in design_editors(design_id)
                && request.resource.contentType == 'image/png'
                && request.resource.size < 20 * 1024 * 1024;
        }

        // Version PDFs — create-once by owner (in-browser compile path), no overwrite/delete
        // by clients (re-creation is allowed again after lifecycle deletion since the object
        // no longer exists)
        match /versions/{version_id}/doc.pdf {

            function version() {
                return firestore.get(
                    /databases/(default)/documents/versions/$(version_id));
            }

            allow get: if true;

            allow create: if request.auth != null
                && resource == null
                && version().data.owner == request.auth.uid
                && request.resource.contentType == 'application/pdf'
                && request.resource.size < 200 * 1024 * 1024;
        }

        // Version cover PDFs — same create-once/owner semantics as doc.pdf (only present for
        // versions whose frozen blueprint has a cover)
        match /versions/{version_id}/cover.pdf {
            allow get: if true;

            allow create: if request.auth != null
                && resource == null
                && firestore.get(
                    /databases/(default)/documents/versions/$(version_id))
                    .data.owner == request.auth.uid
                && request.resource.contentType == 'application/pdf'
                && request.resource.size < 50 * 1024 * 1024;
        }
    }
}
