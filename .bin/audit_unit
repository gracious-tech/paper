#!/usr/bin/env bash

# Run every unit and integration suite:
#
#   typst, typst-web,   pure packages (vitest, no infrastructure; typst-web runs the WASM
#   typst-node          engine in Node, typst-node the Typst CLI)
#   app                 the app's service logic (vitest; see app/vitest.config.mts)
#   tests/rules         firestore.rules + firebase_storage.rules, against the emulators
#   tests/server        the API server's handlers and routes, against the emulators
#   i18n                the translation tooling (app/i18n/tests), then .bin/i18n_check: no
#                       untranslated UI text, catalogs well-formed (missing translations are
#                       reported, not failed — see .claude/skills/translate)
#
# The emulator-backed suites need auth/firestore/storage running. They use firebase_test.json —
# its own ports and no import/export — rather than the dev emulators from .bin/serve_emulators,
# because the rules suites clear Firestore between cases and doing that to the dev stack would
# delete whatever you were working on. If those test ports are already listening (you left
# .bin/serve_emulators_test running) this reuses them; otherwise it starts its own and shuts
# them down afterwards.
#
# Usage:
#   .bin/audit_unit                 everything
#   .bin/audit_unit typst           just that group (typst | typst-web | typst-node | app |
#                                   rules | server | i18n)
#   .bin/audit_unit rules storage   a group, plus a filter passed through to vitest
#
# With COVERAGE=1 each vitest run also exports raw V8 coverage, under its group name, for
# .bin/audit_coverage to merge (see coverage/mcr.unit.ts). The i18n tooling is outside the
# measured scope (coverage/scope.ts), so its run collects none

set -euo pipefail
cd "$(dirname "$0")/.."

export FIREBASE_EMULATORS_PATH="$PWD/.emulator_cache"

# The group to run (default all), and anything after it as a vitest name/path filter
GROUP="${1:-all}"
shift || true
FILTER=("$@")

# Ports from firebase_test.json, so there is one place to change them
FIRESTORE_PORT="$(node -p "require('./firebase_test.json').emulators.firestore.port")"

# The vitest flags that switch coverage on, when asked for
COVERAGE_ARGS=""
if [ "${COVERAGE:-}" = "1" ]; then
    COVERAGE_ARGS="--coverage.enabled --coverage.provider=custom"
    COVERAGE_ARGS+=" --coverage.customProviderModule=vitest-monocart-coverage"
    COVERAGE_ARGS+=" --coverage.coverageReportOptions=$PWD/coverage/mcr.unit.ts"
fi

run_group(){
    # Run one vitest root, echoing which group it is. A third argument of no_coverage keeps a
    # group outside the measured scope from collecting any
    local name="$1" root="$2" coverage="$COVERAGE_ARGS"
    if [ "${3:-}" = "no_coverage" ]; then
        coverage=""
    fi
    echo
    echo "── $name ─────────────────────────────────────────"
    # shellcheck disable=SC2086  # the coverage flags are meant to split
    COVERAGE_GROUP="$name" npx vitest run --root "$root" $coverage "${FILTER[@]}"
}

emulators_up(){
    # Whether something is already answering on the test emulator's Firestore port
    node -e "
        const net = require('node:net')
        const socket = net.connect($FIRESTORE_PORT, '127.0.0.1')
        socket.on('connect', () => {socket.end(); process.exit(0)})
        socket.on('error', () => process.exit(1))
        socket.setTimeout(1000, () => {socket.destroy(); process.exit(1)})
    " 2>/dev/null
}

run_emulator_suites(){
    # Run the emulator-backed suites, reusing a running test emulator or starting one
    local filter_args=""
    if [ ${#FILTER[@]} -gt 0 ]; then
        filter_args=" ${FILTER[*]}"
    fi
    local command="COVERAGE_GROUP=emulators npx vitest run --root tests${1:+ $1}"
    command+="${COVERAGE_ARGS:+ $COVERAGE_ARGS}${filter_args}"
    if emulators_up; then
        echo "(reusing the test emulators already on :$FIRESTORE_PORT)"
        eval "$command"
    else
        # A temp dir of the test stack's own: every Storage emulator empties
        # $TMPDIR/firebase/storage/blobs on start, which would wipe the dev or e2e stack's files
        local emulator_tmp="${TMPDIR:-/tmp}/paper-bible-test"
        mkdir -p "$emulator_tmp"
        TMPDIR="$emulator_tmp" npx firebase emulators:exec \
            --config firebase_test.json \
            --project paper-bible-test \
            --only auth,firestore,storage \
            "$command"
    fi
}

run_i18n(){
    # The translation tooling's own tests, then the gate it implements (see app/i18n/check.ts)
    run_group "i18n" app/i18n no_coverage
    .bin/i18n_check --allow-missing
}

case "$GROUP" in
    all)
        run_i18n
        run_group "typst" typst
        run_group "typst-web" typst-web
        run_group "typst-node" typst-node
        run_group "app" app
        echo
        echo "── rules + server (emulators) ────────────────────"
        run_emulator_suites ""
        ;;
    typst)
        run_group "typst" typst
        ;;
    typst-web)
        run_group "typst-web" typst-web
        ;;
    typst-node)
        run_group "typst-node" typst-node
        ;;
    app)
        run_group "app" app
        ;;
    rules)
        echo "── rules (emulators) ─────────────────────────────"
        run_emulator_suites "rules/"
        ;;
    server)
        echo "── server (emulators) ────────────────────────────"
        run_emulator_suites "server/"
        ;;
    i18n)
        run_i18n
        ;;
    *)
        echo "Unknown group '$GROUP' (typst | typst-web | typst-node | app | rules | server | i18n | all)" >&2
        exit 1
        ;;
esac

echo
echo "All requested suites passed."
