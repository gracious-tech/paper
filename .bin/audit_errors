#!/usr/bin/env bash
# Move the app's error reports out of the Storage bucket (deleted there once stored locally),
# have claude group them and shortlist what to fix next, then triage — or auto-fix one with
# claude in the background and review its diff (needs a clean tree; committing stays manual)
# Usage: errors [--headless] [gcp-project-id]  (defaults to .firebaserc's default project)
# --headless skips the TUI: it syncs, classifies and ranks, then prints the path of the issue
# list for an AI session to triage with errors/triage.ts
# Requires `gcloud auth login` creds; set STORAGE_EMULATOR_HOST=localhost:9199 to target the
# local emulator instead. Triage state lives in gitignored errors/records/
set -euo pipefail
cd "$(dirname "$0")/.."

# Pull down the sourcemaps .bin/deploy_app uploads per build (the site bucket's sourcemaps/
# prefix), so stack traces resolve here whichever machine deployed. Like the reports, the bucket
# is only an inbox (it expires them at 90 days) and errors/sourcemaps/ is the lasting copy, so
# this only ever syncs down, and never deletes. Best-effort: without AWS credentials only the
# local copy is used
SITE_BUCKET="$(aws cloudformation describe-stacks --region us-west-2 \
    --stack-name paper-bible \
    --query "Stacks[0].Outputs[?OutputKey=='SiteBucketName'].OutputValue | [0]" \
    --output text 2>/dev/null || true)"
if [ -n "$SITE_BUCKET" ] && [ "$SITE_BUCKET" != "None" ]; then
    aws s3 sync "s3://$SITE_BUCKET/sourcemaps/" errors/sourcemaps/ --only-show-errors
else
    echo "(Couldn't reach the sourcemap archive, so only local sourcemaps will be used)" >&2
fi

if [ "${1:-}" = "--headless" ]; then
    shift
    node errors/headless.ts "$@"
else
    node errors/cli.ts "$@"
fi
