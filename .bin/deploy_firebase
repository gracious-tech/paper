#!/usr/bin/env bash

# Deploy Firestore/Storage security rules and indexes to Firebase — these remain on Firebase
# regardless of where the app itself is hosted (static hosting is .bin/deploy_app, server code
# is .bin/deploy_api). Unlike .bin/deploy_firebase_initial (one-time per-project bootstrap),
# this runs every time firestore.rules / firebase_storage.rules / firestore.indexes.json change.

set -euo pipefail
cd "$(dirname "$0")/.."

PROJECT="${1:-paper-bible}"

npx firebase deploy --project "$PROJECT" --only firestore,storage
