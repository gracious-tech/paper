#!/usr/bin/env bash

# Run the API server locally against the emulator suite (start .bin/serve_emulators first).
# Vite's dev proxy forwards the app's /api requests here (see app/vite.config.ts).

set -euo pipefail
cd "$(dirname "$0")/.."

export FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
export FIRESTORE_EMULATOR_HOST=localhost:8080
export FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
export GCLOUD_PROJECT=paper-bible
export PORT=8788
export TYPST_PATH="$PWD/.bin/typst"
export FONTS_DIR="$PWD/fonts"
export FETCH_ENDPOINT="${FETCH_ENDPOINT:-http://localhost:8430/}"

node --watch server/src/index.ts
