#!/usr/bin/env bash

# Sync assets/typst/ (see add_typst_version) to the public assets bucket under a typst/ object
# prefix, so consumers fetch `<assets domain>/typst/<npm version>/<wasm filename>`. Version
# dirs are write-once, so unlike deploy_fonts nothing is ever deleted from the bucket.

set -euo pipefail
cd "$(dirname "$0")/.."

BUCKET="${1:-assets.paper.bible}"

# Upload new version dirs (no deletion flag; files already in the bucket are skipped/unchanged)
gcloud storage rsync assets/typst "gs://$BUCKET/typst" --recursive

# WebAssembly.instantiateStreaming() requires an exact application/wasm content-type (gcloud
# won't infer it for .wasm), and version dirs are immutable so cache as hard as possible.
# Access-Control-Allow-Origin is bucket-wide CORS — see setup_firebase.
gcloud storage objects update "gs://$BUCKET/typst/**" \
    --content-type='application/wasm' \
    --cache-control='public, max-age=31536000, immutable'

# GCS can't attach arbitrary response headers, so Cross-Origin-Resource-Policy: cross-origin
# must be added by whatever fronts the bucket (Cloudflare/LB — see setup_firebase notes).
# Also verify the CDN actually compresses these (application/wasm is missing from some CDNs'
# default compressible-types lists, and the compiler is ~28 MB → ~9 MB under brotli):
echo 'Deployed. Verify CDN compression + CORP header, e.g.:'
echo "  curl -sI -H 'Accept-Encoding: br, gzip' \\"
echo "      https://assets.paper.bible/typst/0.7.0-rc2/typst_ts_web_compiler_bg.wasm \\"
echo "      | grep -iE 'content-encoding|cross-origin-resource-policy'"
