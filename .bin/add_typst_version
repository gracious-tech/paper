#!/usr/bin/env bash

# Vendor the typst.ts WASM binaries for a published npm version into assets/typst/<version>/
# (published to the assets bucket by deploy_typst, served in dev under
# /generator_assets/typst/). Consumer apps (paper_cover etc) construct URLs as
# `<assets prefix>/typst/<their installed npm version>/<wasm filename>` and cache them as
# immutable, so version dirs are write-once: never modify or delete a published one — adding
# new versions just adds new dirs.

set -euo pipefail
cd "$(dirname "$0")/.."

VERSION="${1:?Usage: add_typst_version <npm version, e.g. 0.7.0-rc2>}"
DEST="assets/typst/$VERSION"

# Refuse to touch an existing version dir (write-once contract)
if [ -e "$DEST" ]; then
    echo "$DEST already exists — published version dirs are immutable" >&2
    exit 1
fi
mkdir -p "$DEST"

# Fetch both packages via npm pack and extract each tarball into its own subdir (both
# tarballs extract to package/, so they can't share one), then copy the binaries verbatim
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
for package in typst-ts-web-compiler typst-ts-renderer; do
    mkdir "$TMP/$package"
    tarball="$(npm pack "@myriaddreamin/$package@$VERSION" --pack-destination "$TMP" | tail -1)"
    tar -xzf "$TMP/$tarball" -C "$TMP/$package"
    cp "$TMP/$package/package/pkg/"*.wasm "$DEST/"
done

echo "Vendored into $DEST:"
ls -lh "$DEST"
