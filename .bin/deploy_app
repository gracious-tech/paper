#!/usr/bin/env bash

# Deploy the app in full: static hosting to AWS (S3/CloudFront, see .bin/deploy_hosting) and
# Firestore/Storage rules to Firebase — these remain on Firebase regardless of where the app
# itself is hosted. Pass a project alias to target Firebase, e.g. `deploy_app prod` (defaults
# to dev); AWS targeting is via the STACK/REGION env vars .bin/deploy_hosting reads.

set -euo pipefail
cd "$(dirname "$0")/.."

PROJECT="${1:-paper-bible}"

.bin/deploy_hosting
npx firebase deploy --project "$PROJECT" --only firestore,storage
