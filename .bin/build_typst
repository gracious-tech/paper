#!/bin/bash
# Build local Typst modules in dependency order (core, then web/node wrappers)
set -e
cd "$(dirname "$(dirname "$0")")"


# Regenerate the inlined title-page pattern SVGs (embeds them into the typst package's JS)
ROOT="$PWD"
node "$ROOT/typst/gen_patterns.ts"


# Compile each module's TypeScript to its dist/ output (paths relative to repo root)
for module in generic/typst-utils generic/pm-to-typst typst typst-web typst-node; do
    cd "$ROOT/$module"
    npx tsc
done
