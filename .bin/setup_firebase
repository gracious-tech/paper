#!/usr/bin/env bash

# One-time Firebase/GCP setup for a project (run per dev/prod project after creating it in the
# Firebase console and upgrading it to the Blaze plan). Requires `firebase login` first.
# Firestore/Auth/Storage are the only Firebase pieces this project still uses — hosting and
# compute are AWS (see .bin/setup_aws) — so this script only covers those three.
#
# Manual console steps not covered here:
#   1. Create the Firebase project + web app (copy config into app/src/services/firebase.ts)
#   2. Upgrade to Blaze plan
#   3. Enable Auth providers: Anonymous, Google, Email link
#   4. Enable Firestore (native mode) + default Storage bucket

set -euo pipefail
cd "$(dirname "$0")/.."

PROJECT="${1:?Usage: setup_firebase <gcp-project-id>}"

# Apply the 1-year lifecycle rule for creation PDFs to the default Storage bucket
gcloud storage buckets update "gs://$PROJECT.firebasestorage.app" \
    --project "$PROJECT" --lifecycle-file=firebase_storage_lifecycle.json

# Expire compile_stats telemetry rows after ~1 year, and every daily quota row a week after the
# day it counts (Firestore native TTL on the `expires` field each row carries — see
# COMPILE_STATS_LIFETIME_MS / QUOTA_LIFETIME_MS in typst/src/consts.ts). Idempotent:
# re-running with a policy already enabled is a no-op.
# WARN Each quota collection needs its own line — they're listed in QUOTA_COLLECTIONS
# (server/src/quota.ts), and one without a policy here keeps a permanent row per user
gcloud firestore fields ttls update expires \
    --collection-group=compile_stats --enable-ttl --project "$PROJECT" --quiet
gcloud firestore fields ttls update expires \
    --collection-group=compile_quota --enable-ttl --project "$PROJECT" --quiet
gcloud firestore fields ttls update expires \
    --collection-group=copy_quota --enable-ttl --project "$PROJECT" --quiet

echo "Done. Now run .bin/setup_aws"
