#!/usr/bin/env bash

# One-time Firebase/GCP setup for a project (run per dev/prod project after creating it in the
# Firebase console and upgrading it to the Blaze plan). Requires `firebase login` and
# `gcloud auth login` first.
#
# Manual console steps not covered here:
#   1. Create the Firebase project + web app (copy config into app/src/services/firebase.ts)
#   2. Upgrade to Blaze plan
#   3. Enable Auth providers: Anonymous, Google, Email link
#   4. Enable Firestore (native mode) + default Storage bucket
#   5. Point the assets subdomain (e.g. assets.paper.bible) at the assets bucket via a load
#      balancer backend-bucket + managed cert, or a CDN/DNS proxy such as Cloudflare

set -euo pipefail
cd "$(dirname "$0")/.."

PROJECT="${1:?Usage: setup_firebase <gcp-project-id> [assets-bucket]}"
ASSETS_BUCKET="${2:-assets.paper.bible}"

# Apply the 1-year lifecycle rule for creation PDFs to the default Storage bucket
gcloud storage buckets update "gs://$PROJECT.firebasestorage.app" \
    --project "$PROJECT" --lifecycle-file=firebase_storage_lifecycle.json

# Expire compile_stats telemetry rows after ~1 year (Firestore native TTL on the `expires`
# field each row carries — see COMPILE_STATS_LIFETIME_MS in typst/src/consts.ts). Idempotent:
# re-running with the policy already enabled is a no-op
gcloud firestore fields ttls update expires \
    --collection-group=compile_stats --enable-ttl --project "$PROJECT" --quiet

# Let Cloud Run's runtime service account read the assets bucket — the bucket itself is
# created and published by the bookcover repo, but the compile service here mounts it as a
# GCS volume (see deploy_server), and volume mounts authenticate as the service account
# regardless of the bucket being publicly readable
PROJECT_NUMBER="$(gcloud projects describe "$PROJECT" --format 'value(projectNumber)')"
gcloud storage buckets add-iam-policy-binding "gs://$ASSETS_BUCKET" \
    --member="serviceAccount:$PROJECT_NUMBER-compute@developer.gserviceaccount.com" \
    --role=roles/storage.objectViewer

echo "Done. Now run .bin/deploy_server and .bin/deploy_app"
