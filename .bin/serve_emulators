#!/usr/bin/env bash

# Run the Firebase emulator suite (auth, firestore, storage) for local development.
# State persists across restarts via import/export into the gitignored .emulator_data/ dir.
# Downloaded emulator binaries are cached in the gitignored .emulators/ dir (instead of
# ~/.cache/firebase) so they survive Docker rebuilds that only persist the project dir.

set -euo pipefail
cd "$(dirname "$0")/.."

export FIREBASE_EMULATORS_PATH="$PWD/.emulator_cache"

# Every Storage emulator keeps its files in $TMPDIR/firebase/storage/blobs and empties it on
# start, so each stack gets a temp dir of its own (one per stack suffices: its ports already
# stop two of the same running at once)
export TMPDIR="${TMPDIR:-/tmp}/paper-bible-dev"
mkdir -p "$TMPDIR"

npx firebase emulators:start --import .emulator_data --export-on-exit "$@"
