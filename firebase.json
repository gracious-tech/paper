{
    "hosting": {
        "public": "app/dist",
        "cleanUrls": true,
        "rewrites": [
            {
                "source": "/api/compile",
                "run": {
                    "serviceId": "paper-bible-compile",
                    "region": "us-west1"
                }
            },
            {
                "source": "/api/**",
                "run": {
                    "serviceId": "paper-bible-api",
                    "region": "us-west1"
                }
            },
            {
                "source": "**",
                "destination": "/index.html"
            }
        ],
        "headers": [
            {
                "source": "/assets/**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=31536000, immutable"
                    }
                ]
            }
        ]
    },
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "storage": {
        "rules": "firebase_storage.rules"
    },
    "emulators": {
        "auth": {
            "port": 9099
        },
        "firestore": {
            "port": 8080
        },
        "storage": {
            "port": 9199
        },
        "ui": {
            "enabled": true
        },
        "singleProjectMode": true
    }
}
