{
    "name": "paper-bible-typst",
    "version": "0.1.0",
    "type": "module",
    "//sideEffects": "Pure functions, constants and data only — so bundlers may drop any module of this package the consumer doesn't reach. Without it the barrel keeps pdf_postprocess (and its ~700KB of pdf-lib) in the app's main chunk, though only the Typst worker ever calls it",
    "sideEffects": false,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsc",
        "watch": "tsc --watch",
        "test": "vitest run"
    },
    "dependencies": {
        "@gracious.tech/fetch-client": "^2.4.0",
        "pdf-lib": "^1.17.1",
        "pm-to-typst": "^0.1.0",
        "printing-services": "^1.5.1",
        "typst-fonts": "^0.1.1",
        "typst-utils": "^0.2.0",
        "uqr": "^0.1.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "vitest": "^4.1.2"
    }
}
