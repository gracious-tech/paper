rules_version = '2';


// NOTE Anonymous users are real auth users, so `signed_in()` covers guests too
// NOTE Design-invite redemption and account merging happen via the server (Admin SDK bypasses
//      these rules), so no token-comparison patterns are needed here. Versions need no such
//      redemption step — they're publicly readable by id directly (see below)

service cloud.firestore {
    match /databases/{database}/documents {

        // Whether the request comes from any authenticated user (including anonymous)
        function signed_in() {
            return request.auth != null;
        }

        // User profiles, their custom font library, and their viewed-designs history (all
        // owner only)
        match /users/{uid} {
            allow read, write: if signed_in() && request.auth.uid == uid;

            match /fonts/{font_id} {
                allow read, write: if signed_in() && request.auth.uid == uid;
            }

            match /viewed/{design_id} {
                allow read, write: if signed_in() && request.auth.uid == uid;
            }
        }

        // Designs (editable blueprints, owner + invited editors)
        match /designs/{design_id} {

            // Owner must create with themselves in the editors array
            allow create: if signed_in()
                && request.resource.data.owner == request.auth.uid
                && request.auth.uid in request.resource.data.editor_uids;

            // Any editor may read (owner is always in editor_uids)
            allow read: if signed_in() && request.auth.uid in resource.data.editor_uids;

            // Editors may update content, but only the owner may touch membership/sharing
            allow update: if signed_in() && request.auth.uid in resource.data.editor_uids
                && request.resource.data.owner == resource.data.owner
                && (request.auth.uid == resource.data.owner
                    || !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['editor_uids', 'editors', 'share_token', 'owner']));

            // Only the owner may delete
            allow delete: if signed_in() && request.auth.uid == resource.data.owner;
        }

        // Versions (immutable rendered snapshots, nested under the design they came from)
        match /versions/{version_id} {

            // Only editors of the parent design may attach versions to it, and lifecycle fields
            // can't be forged at create (status/created/pdf_path are pinned — the server trusts
            // pdf_path-by-convention and viewers trust created-ordering for "latest version")
            allow create: if signed_in()
                && request.resource.data.owner == request.auth.uid
                && request.auth.uid in get(/databases/$(database)/documents/designs/$(request.resource.data.design_id)).data.editor_uids
                && request.resource.data.status == 'pending'
                && request.resource.data.created == request.time
                && request.resource.data.pdf_path == 'versions/' + version_id + '/doc.pdf'
                && request.resource.data.blueprint is map
                && request.resource.data.save_token is string;

            // Publicly gettable by id — like firebase_storage.rules, the id itself (an unguessable
            // url64 token) is the whole capability, so sharing is just the URL
            allow get: if true;

            // Queries must pin design_id with an equality filter (the only way this condition is
            // statically provable) — keeps the collection non-enumerable (no bare dumps, no
            // owner-based queries) while allowing per-design version lists
            allow list: if resource.data.design_id is string;

            // Immutable except lifecycle fields (client updates status/pages/expiry when it
            // compiles via WASM)
            allow update: if signed_in() && request.auth.uid == resource.data.owner
                && !request.resource.data.diff(resource.data).affectedKeys()
                    .hasAny(['blueprint', 'owner', 'created', 'design_id', 'copied_from',
                        'custom_fonts', 'save_token', 'pdf_path', 'title']);

            allow delete: if signed_in() && request.auth.uid == resource.data.owner;
        }

        // Compile performance telemetry — one row per interior compile attempt (browser or
        // server). Write-only for the owner: it's analysed offline (Firestore export), never
        // read back in-app, and deliberately not under versions/ so it isn't exposed by a
        // shared version id. The server writes here too, via the Admin SDK (bypasses rules).
        // signed_in() never blocks a real write: anon users are signed in (see note above), and
        // a compile always has a signed-in owner anyway (versions require one to be created).
        // Rows carry an `expires` field and a Firestore TTL policy (set by .bin/setup_firebase)
        // drops them after ~1 year
        match /compile_stats/{stat_id} {
            allow create: if signed_in() && request.resource.data.owner == request.auth.uid;
        }
    }
}
